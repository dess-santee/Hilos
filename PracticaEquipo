// CON MUTEX
void hilo3ConMutex() {

    auto inicio = chrono::high_resolution_clock::now();

    for (long long i = 0; i < LIMITE; i++) {

        mtx.lock();

        /*
        ============================================
        AQUÍ EL SE COLOCA LA MISMA OPERACIÓN DEL HILO 3
        ============================================

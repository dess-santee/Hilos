// ======================================================
// MAIN
// ======================================================

int main() {

    // --------------------------------------------------
    // PRUEBA SIN MUTEX
    // --------------------------------------------------

    cout << "==========================================" << endl;
    cout << "            PRUEBA SIN MUTEX" << endl;
    cout << "==========================================" << endl;

    variableCompartida = 1;

    auto inicioTotal = chrono::high_resolution_clock::now();

    thread hilo1(hilo1SinMutex);
    thread hilo2(hilo2SinMutex);
    thread hilo3(hilo3SinMutex);

    hilo1.join();
    hilo2.join();
    hilo3.join();

    auto finTotal = chrono::high_resolution_clock::now();

    chrono::duration<double> tiempoTotal = finTotal - inicioTotal;

    cout << endl;

    cout << "Resultado final SIN mutex: "
         << variableCompartida << endl;

    cout << "Tiempo total SIN mutex: "
         << tiempoTotal.count()
         << " segundos" << endl;



    // --------------------------------------------------
    // PRUEBA CON MUTEX
    // --------------------------------------------------

    cout << endl;
    cout << "==========================================" << endl;
    cout << "            PRUEBA CON MUTEX" << endl;
    cout << "==========================================" << endl;

    variableCompartida = 1;

    inicioTotal = chrono::high_resolution_clock::now();

    thread hilo4(hilo1ConMutex);
    thread hilo5(hilo2ConMutex);
    thread hilo6(hilo3ConMutex);

    hilo4.join();
    hilo5.join();
    hilo6.join();

    finTotal = chrono::high_resolution_clock::now();

    tiempoTotal = finTotal - inicioTotal;

    cout << endl;

    cout << "Resultado final CON mutex: "
         << variableCompartida << endl;


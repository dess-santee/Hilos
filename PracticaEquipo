#include <iostream>
#include <thread>
#include <mutex>
#include <chrono>

using namespace std;

const long long LIMITE = 10000000;

long long variableCompartida = 1;

mutex mtx;

// ======================================================
// HILO 1 - AITANA
// ======================================================

// SIN MUTEX
void hilo1SinMutex() {

    auto inicio = chrono::high_resolution_clock::now();

    for (long long i = 0; i < LIMITE; i++) {

        // Mi operación:
        // modificar constantemente la variable compartida

        variableCompartida += (i % 10);
    }

    auto fin = chrono::high_resolution_clock::now();

    chrono::duration<double> tiempo = fin - inicio;

    cout << "Tiempo Hilo 1 SIN mutex: "
         << tiempo.count()
         << " segundos" << endl;
}


// CON MUTEX
void hilo1ConMutex() {

    auto inicio = chrono::high_resolution_clock::now();

    for (long long i = 0; i < LIMITE; i++) {

        mtx.lock();

        variableCompartida += (i % 10);

        mtx.unlock();
    }

    auto fin = chrono::high_resolution_clock::now();

    chrono::duration<double> tiempo = fin - inicio;

    cout << "Tiempo Hilo 1 CON mutex: "
         << tiempo.count()
         << " segundos" << endl;
}



// ======================================================
// HILO 2 Hilo de Dessireé
// ======================================================

// SIN MUTEX
void hilo2SinMutex() {

    auto inicio = chrono::high_resolution_clock::now();

    for (long long i = 0; i < LIMITE; i++) {
        variableCompartida -= (i % 10);
    }

    auto fin = chrono::high_resolution_clock::now();

    chrono::duration<double> tiempo = fin - inicio;

    cout << "Tiempo Hilo 2 SIN mutex: "
         << tiempo.count()
         << " segundos" << endl;
}


// CON MUTEX
void hilo2ConMutex() {

    auto inicio = chrono::high_resolution_clock::now();

    for (long long i = 0; i < LIMITE; i++) {

        mtx.lock();
        variableCompartida -= (i % 10);
        mtx.unlock();
    }

    auto fin = chrono::high_resolution_clock::now();

    chrono::duration<double> tiempo = fin - inicio;

    cout << "Tiempo Hilo 2 CON mutex: "
         << tiempo.count()
         << " segundos" << endl;
}




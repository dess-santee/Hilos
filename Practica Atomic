#include <iostream>
#include <thread>
#include <atomic>
#include <chrono>
#include <vector>
#include <random>

using namespace std;
using namespace std::chrono;

// =====================================================
// CONFIGURACIÓN GENERAL
// =====================================================

const int NUM_DATOS = 10000000;
const int X = 50;

// =====================================================
// VARIABLES ATOMIC
// =====================================================

// Contadores individuales de cada hilo
atomic<long long> contadorHilo1(0);
atomic<long long> contadorHilo2(0);
atomic<long long> contadorHilo3(0);

// Variable global compartida por los 3 hilos
atomic<long long> contadorGlobal(0);

// Vector global de datos
vector<int> datos(NUM_DATOS);


// =====================================================
// HILO 1 - Aitana
// =====================================================
// PROCESO: Realizar operaciones aritméticas con los 10M
// de datos (Multiplicación).
// =====================================================

void hilo1()
{
    auto inicio = high_resolution_clock::now();

    long long contadorLocal = 0;

    for (int i = 0; i < NUM_DATOS; i++)
    {
        int resultado = datos[i] * 2;
        contadorLocal++;
        contadorGlobal.fetch_add(1);
    }

    contadorHilo1.store(contadorLocal);

    auto fin = high_resolution_clock::now();
    duration<double> tiempo = fin - inicio;

    cout << "[Hilo 1 - Aitana] Operaciones realizadas: "
         << contadorHilo1.load() << endl;

    cout << "[Hilo 1 - Aitana] Tiempo: "
         << tiempo.count()
         << " segundos\n" << endl;
}


// =====================================================
// HILO 2 - Dessiree Niño Santel
// =====================================================
// PROCESO: Buscar la cantidad de números múltiplos de X.
// =====================================================

void hilo2()
{
    auto inicio = high_resolution_clock::now();

    long long contadorLocal = 0;

    for (int i = 0; i < NUM_DATOS; i++)
    {
        if (X != 0 && datos[i] % X == 0)
        {
            contadorLocal++;
        }

        contadorGlobal.fetch_add(1);
    }

    contadorHilo2.store(contadorLocal);

    auto fin = high_resolution_clock::now();
    duration<double> tiempo = fin - inicio;

    cout << "[Hilo 2 - Dessiree] Cantidad de multiplos de " << X << " encontrados: "
         << contadorHilo2.load() << endl;

    cout << "[Hilo 2 - Dessiree] Tiempo: "
         << tiempo.count()
         << " segundos\n" << endl;
}


// =====================================================
// HILO 3 - Carlos Romero Samano
// =====================================================
// PROCESO: Cantidad de números mayores a X encontrados.
// =====================================================

void hilo3() 
{
    auto inicio = high_resolution_clock::now();

    long long contadorLocal = 0;

    for (int i = 0; i < NUM_DATOS; ++i) 
    {
        if (datos[i] > X) 
        {
            contadorLocal++;
        }
        contadorGlobal.fetch_add(1);
    }

    contadorHilo3.store(contadorLocal);

    auto fin = high_resolution_clock::now();
    duration<double> tiempo = fin - inicio;

    cout << "[Hilo 3 - Carlos] Numeros mayores a " << X << ": " 
         << contadorHilo3.load() << endl;

    cout << "[Hilo 3 - Carlos] Tiempo: "
         << tiempo.count()
         << " segundos\n" << endl;
}


// =====================================================
// FUNCIÓN PRINCIPAL (MAIN)
// =====================================================

int main()
{
    cout << "=====================================================" << endl;
    cout << " Generando " << NUM_DATOS << " datos aleatorios..." << endl;
    cout << "=====================================================\n" << endl;

    // Generar números aleatorios entre 1 y 100
    mt19937 gen(42); 
    uniform_int_distribution<int> dist(1, 100);

    for (int i = 0; i < NUM_DATOS; ++i)
    {
        datos[i] = dist(gen);
    }

    cout << "Iniciando ejecución concurrente de los hilos...\n" << endl;
    auto inicioGlobal = high_resolution_clock::now();

    // Crear y lanzar los hilos
    thread t1(hilo1);
    thread t2(hilo2);
    thread t3(hilo3);

    // Esperar a que terminen los 3 hilos
    t1.join();
    t2.join();
    t3.join();

    auto finGlobal = high_resolution_clock::now();
    duration<double> tiempoTotal = finGlobal - inicioGlobal;

    // Despliegue de resultados globales
    long long sumaDeContadores = contadorHilo1.load() + contadorHilo2.load() + contadorHilo3.load();

    cout << "=====================================================" << endl;
    cout << "                 RESUMEN DE RESULTADOS               " << endl;
    cout << "=====================================================" << endl;
    cout << "Contador Hilo 1 (Aitana)   : " << contadorHilo1.load() << endl;
    cout << "Contador Hilo 2 (Dessireé) : " << contadorHilo2.load() << endl;
    cout << "Contador Hilo 3 (Carlos)   : " << contadorHilo3.load() << endl;
    cout << "-----------------------------------------------------" << endl;
    cout << "Contador Global (fetch_add): " << contadorGlobal.load() << endl;
    cout << "Suma de Hilo1+Hilo2+Hilo3  : " << sumaDeContadores << endl;
    cout << "Tiempo Total de Ejecución  : " << tiempoTotal.count() << " segundos" << endl;
    cout << "=====================================================" << endl;

    return 0;
}
